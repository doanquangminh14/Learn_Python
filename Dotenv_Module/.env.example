# =============================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: File này được commit lên Git làm mẫu cho thành viên trong nhóm.
# Tuyệt đối KHÔNG điền mật khẩu/khóa bí mật thật vào file này!
# =============================================================================

# Cấu hình ứng dụng
APP_NAME="Python Learning App"
APP_ENV="development"
DEBUG=True
PORT=8000

# Cấu hình Cơ sở dữ liệu
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="my_database"
DB_USER="postgres"
DB_PASSWORD="your_database_password_here"

# Khóa API bí mật của bên thứ ba
OPENAI_API_KEY="sk-your-openai-api-key-here"
JWT_SECRET_KEY="your-super-secret-jwt-token-key-change-in-production"
